# ParaguAI — apontando a APLICAÇÃO para o Supabase self-hosted (Sprint 16).
# TEMPLATE, sem segredos. Copie para `.env.selfhosted` (já ignorado pelo Git)
# e preencha com os valores gerados em infra/selfhosted/.env.
#
# ATENÇÃO: este arquivo NÃO substitui `.env.local`. A Sprint 16 é preparação
# de infraestrutura, não migração de produção — a troca definitiva do
# ambiente da aplicação é uma Sprint posterior, com autorização explícita.
#
# Precedência no Next.js: `.env.development.local` (LOCAL, loopback) vence em
# desenvolvimento. Para testar contra o self-hosted, carregue este arquivo
# explicitamente em vez de renomeá-lo por cima dos existentes.

# Mesma URL pública do Kong no VPS (API_EXTERNAL_URL do lado da infra).
NEXT_PUBLIC_SUPABASE_URL=https://api.paraguai.example

# JWT `role=anon` assinado com o JWT_SECRET do self-hosted. Público por
# definição — protegido por RLS, nunca por obscuridade.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<<ANON_KEY-DO-SELF-HOSTED>>

# JWT `role=service_role`. Ignora RLS por completo: só no servidor, nunca
# num componente cliente, nunca num `NEXT_PUBLIC_*`.
SUPABASE_SERVICE_ROLE_KEY=<<SERVICE_ROLE_KEY-DO-SELF-HOSTED>>

# Segredo compartilhado das rotas /api/cron/* (lib/cron-auth.ts).
CRON_SECRET=<<GERAR>>

# Percentual de rollout do read-through do Marketplace Memory.
PRODUCT_IDENTITY_MEMORY_ROLLOUT_PERCENT=50
