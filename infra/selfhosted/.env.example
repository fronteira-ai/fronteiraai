# ParaguAI — infraestrutura self-hosted (Sprint 16). TEMPLATE.
#
# Copie para /etc/paraguai/backup.env (chmod 600, dono paraguai) e para
# .env ao lado do docker-compose. NUNCA versione o arquivo preenchido:
# infra/selfhosted/.env e /etc/paraguai/* estão no .gitignore.
#
# Gere cada segredo com: openssl rand -base64 48
# Nenhum valor abaixo é real — são placeholders.

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<<GERAR>>

# ── Supabase: chaves de API ──────────────────────────────────────────────
# JWT_SECRET tem de ter no mínimo 32 caracteres. ANON_KEY e SERVICE_ROLE_KEY
# são JWTs ASSINADOS com esse segredo — gere pelo utilitário oficial
# (https://supabase.com/docs/guides/self-hosting#api-keys), nunca à mão.
JWT_SECRET=<<GERAR-MIN-32-CHARS>>
ANON_KEY=<<JWT-ASSINADO-COM-JWT_SECRET-role=anon>>
SERVICE_ROLE_KEY=<<JWT-ASSINADO-COM-JWT_SECRET-role=service_role>>

# ── URLs públicas ────────────────────────────────────────────────────────
SITE_URL=https://paraguai.example
API_EXTERNAL_URL=https://api.paraguai.example
SUPABASE_PUBLIC_URL=https://api.paraguai.example

# ── Auth (GoTrue) ────────────────────────────────────────────────────────
# O ParaguAI usa e-mail/senha e troca de código OAuth. Confirmação de
# e-mail exige SMTP real — sem SMTP, cadastros ficam pendentes.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ParaguAI
SMTP_ADMIN_EMAIL=

# ── Studio (painel administrativo) ───────────────────────────────────────
# Nunca exposto sem autenticação. Protegido por Basic Auth no reverse proxy.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<<GERAR>>

# ── Backup ───────────────────────────────────────────────────────────────
BACKUP_ROOT=/backups/paraguai
RETENTION_COUNT=10
# Destino externo (rclone). VAZIO = SEM cópia externa; o healthcheck trata
# isso como ALERTA, não como configuração opcional.
RCLONE_REMOTE=
# Variáveis lidas pelo backup.sh via libpq (PGHOST/PGUSER/PGPASSWORD...)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=<<MESMO-QUE-POSTGRES_PASSWORD>>

# ── Monitoramento ────────────────────────────────────────────────────────
DISK_THRESHOLD=80
MAX_BACKUP_AGE_HOURS=84
