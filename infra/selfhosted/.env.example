# ParaguAI — infraestrutura self-hosted. TEMPLATE. Nenhum valor abaixo é real.
#
# Auditado contra o stack oficial na ref FIXA:
#   repo:   https://github.com/supabase/supabase
#   ref:    self-hosted/v0.7.2
#   commit: 549db119c44c25167461812041ba198bde2b31a4
#
# Este arquivo tem DUAS seções com destinos diferentes:
#
#   [A] STACK   -> /opt/supabase-stack/docker/.env   (root:root 0600)
#   [B] BACKUP  -> /etc/paraguai/backup.env          (root:paraguai 0640)
#
# NUNCA versione o arquivo preenchido: `.env*` e `/etc/paraguai/*` estão no
# .gitignore, e apenas os `*.example` são liberados.
#
# ── GERAÇÃO DE SEGREDOS ──────────────────────────────────────────────────
# O upstream traz utilitários próprios; prefira-os a gerar JWT à mão:
#   cd /opt/supabase-stack/docker
#   sh utils/generate-keys.sh        # JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY
#   sh utils/add-new-auth-keys.sh    # par ES256 + chaves opacas
# Segredos avulsos: openssl rand -base64 48 (ou o tamanho exigido em cada
# linha — vários têm comprimento OBRIGATÓRIO; respeite-os).


############################################################################
# [A] STACK — /opt/supabase-stack/docker/.env
############################################################################

# ── Composição ───────────────────────────────────────────────────────────
# Mecanismo oficial: lista separada por ':', arquivo base primeiro. Mantém o
# checkout do upstream limpo — nada é copiado por cima dele.
COMPOSE_FILE=docker-compose.yml:/opt/paraguai/infra/selfhosted/docker-compose.override.yml

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<<GERAR>>
POSTGRES_HOST=db
POSTGRES_DB=postgres
# Porta usada DENTRO do container (PGPORT) e pelos demais serviços.
# Publicada apenas em 127.0.0.1 pelo override. O supavisor está desligado.
POSTGRES_PORT=5432

# ── Chaves legadas (HS256) ───────────────────────────────────────────────
# JWT_SECRET: mínimo 32 caracteres. ANON_KEY e SERVICE_ROLE_KEY são JWTs
# ASSINADOS com ele — gere pelo utilitário oficial, nunca à mão.
JWT_SECRET=<<GERAR-MIN-32-CHARS>>
ANON_KEY=<<JWT-ASSINADO-role=anon>>
SERVICE_ROLE_KEY=<<JWT-ASSINADO-role=service_role>>
JWT_EXPIRY=3600

# ── Chaves assimétricas (ES256) e chaves opacas ──────────────────────────
# Geradas por utils/add-new-auth-keys.sh. Podem ficar vazias enquanto o
# projeto usar apenas as chaves legadas acima.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ── Chaves de criptografia (COMPRIMENTO OBRIGATÓRIO) ─────────────────────
# Perder qualquer uma destas depois do primeiro boot torna ilegível o dado
# que ela protege. Guarde-as junto com o backup, não só no servidor.
# >= 64 chars  — openssl rand -base64 48
SECRET_KEY_BASE=<<GERAR-MIN-64-CHARS>>
# exatamente 16 chars — openssl rand -hex 8
REALTIME_DB_ENC_KEY=<<GERAR-16-CHARS>>
# exatamente 32 chars — openssl rand -hex 16
VAULT_ENC_KEY=<<GERAR-32-CHARS>>
# >= 32 chars — openssl rand -base64 24
PG_META_CRYPTO_KEY=<<GERAR-MIN-32-CHARS>>

# ── Studio (painel administrativo) ───────────────────────────────────────
# Nunca exposto sem autenticação: loopback + Basic Auth no reverse proxy.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<<GERAR>>
STUDIO_DEFAULT_ORGANIZATION=ParaguAI
STUDIO_DEFAULT_PROJECT=ParaguAI
# Opcional: habilita o AI Assistant do Studio. Deixe vazio se não usar.
OPENAI_API_KEY=

# ── URLs públicas ────────────────────────────────────────────────────────
SUPABASE_PUBLIC_URL=https://api.paraguai.example
API_EXTERNAL_URL=https://api.paraguai.example/auth/v1
SITE_URL=https://paraguai.example
ADDITIONAL_REDIRECT_URLS=

# ── Auth (GoTrue) ────────────────────────────────────────────────────────
# O ParaguAI usa e-mail/senha e troca de código OAuth. Confirmação de
# e-mail exige SMTP real — sem SMTP, cadastros ficam pendentes.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=<<PREENCHER>>
SMTP_HOST=<<PREENCHER>>
SMTP_PORT=587
SMTP_USER=<<PREENCHER>>
SMTP_PASS=<<GERAR-OU-PREENCHER>>
SMTP_SENDER_NAME=ParaguAI
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# ── PostgREST ────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ── Storage ──────────────────────────────────────────────────────────────
# Backend de arquivo (não S3). O bucket `catalog` é criado depois do boot.
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=paraguai
# Endpoint do protocolo S3 do Storage. Gere mesmo sem usar S3 externo:
# ID     — openssl rand -hex 16
# SECRET — openssl rand -hex 32
S3_PROTOCOL_ACCESS_KEY_ID=<<GERAR-HEX-16>>
S3_PROTOCOL_ACCESS_KEY_SECRET=<<GERAR-HEX-32>>
# Usados apenas pelo overlay docker-compose.s3.yml (MinIO/RustFS). Não
# utilizados nesta arquitetura; mantidos para não quebrar interpolação.
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=<<GERAR-MIN-8-CHARS>>

# ── imgproxy ─────────────────────────────────────────────────────────────
IMGPROXY_AUTO_WEBP=true

# ── Supavisor (DESLIGADO pelo override) ──────────────────────────────────
# Mantidos porque o compose base interpola estas variáveis mesmo com o
# serviço desativado. NÃO reativar o supavisor sem fixar o bind em
# 127.0.0.1 nas duas portas — ver comentário 1 do override.
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=paraguai
POOLER_DB_POOL_SIZE=5

# ── Functions (DESLIGADO pelo override) ──────────────────────────────────
FUNCTIONS_VERIFY_JWT=false

# ── Logs / Analytics (overlay não utilizado) ─────────────────────────────
# O stack de logs (Vector + Logflare) só sobe via docker-compose.logs.yml.
# Estas variáveis existem para a interpolação não falhar.
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
LOGFLARE_PUBLIC_ACCESS_TOKEN=<<GERAR-MIN-32-CHARS>>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<<GERAR-MIN-32-CHARS>>
GOOGLE_PROJECT_ID=stub
GOOGLE_PROJECT_NUMBER=stub

# ── Kong (API gateway) ───────────────────────────────────────────────────
# O override publica Kong apenas em 127.0.0.1:8000 e não publica 8443:
# quem termina TLS é o Caddy, na 443. Estes valores permanecem como portas
# de CONTAINER referenciadas pelo compose base.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── Reverse proxy (overlay não utilizado) ────────────────────────────────
# O Caddy do ParaguAI é gerenciado fora do stack. Mantidos para interpolação.
PROXY_DOMAIN=api.paraguai.example
CERTBOT_EMAIL=<<PREENCHER>>


############################################################################
# [B] BACKUP — /etc/paraguai/backup.env   (root:paraguai 0640)
#
# Lido pelo paraguai-backup.service via EnvironmentFile. NÃO faz parte do
# stack: não copie esta seção para o .env do Supabase.
#
# ── POR QUE root:paraguai 0640, E NÃO 0600 DO paraguai ──────────────────
# O systemd lê o EnvironmentFile como root, ANTES de baixar privilégio para
# User=paraguai — então o serviço não precisa ser dono do arquivo. Se fosse,
# o próprio usuário de serviço poderia reescrever RCLONE_REMOTE e PGHOST e
# redirecionar para onde quisesse os backups e a conexão de banco. Root como
# dono torna a configuração legível pelo serviço e imutável para ele.
############################################################################

BACKUP_ROOT=/backups/paraguai
RETENTION_COUNT=10

# ── Destino externo (rclone) ─────────────────────────────────────────────
# VAZIO = SEM cópia externa; o healthcheck trata isso como ALERTA, não como
# configuração opcional.
#   formato: <remote>:<bucket>[/<prefixo>]        ex.: r2:paraguai-backups
RCLONE_REMOTE=

# Caminho EXPLÍCITO da configuração do rclone. Sem esta variável, o rclone
# resolveria o arquivo a partir do HOME do processo — que, para o usuário de
# serviço, é /var/lib/paraguai/.config/rclone/rclone.conf, um caminho que o
# PRÓPRIO paraguai pode criar e reescrever. Ou seja: o serviço poderia
# apontar os backups para um destino sob seu controle.
#
# O arquivo referenciado deve ser root:paraguai 0640 — o serviço lê as
# credenciais R2 (precisa, para enviar) mas não consegue alterá-las.
# Nunca versione esse arquivo: `/etc/paraguai/*` está no .gitignore.
RCLONE_CONFIG=/etc/paraguai/rclone.conf

# Conexão do pg_dump. Aponta para a publicação em loopback do serviço `db`
# feita pelo override — nunca para o supavisor (desligado).
# ATENÇÃO: o servidor é PostgreSQL 17 (supabase/postgres:17.6.1.136); o
# pg_dump do host precisa ser >= 17 ou a exportação é recusada.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=<<MESMO-QUE-POSTGRES_PASSWORD>>

# ── Monitoramento (healthcheck.sh) ───────────────────────────────────────
# ATENÇÃO: o healthcheck também chama `rclone lsd "$RCLONE_REMOTE"`. O
# mecanismo que o executar (timer ou cron) PRECISA carregar este mesmo
# arquivo como EnvironmentFile — sem RCLONE_CONFIG e RCLONE_REMOTE no
# ambiente, ele reportaria "destino externo inacessível" por falta de
# configuração, e não por falha real. Alarme falso treina a equipe a
# ignorar o alerta que importa.
DISK_THRESHOLD=80
MAX_BACKUP_AGE_HOURS=84
